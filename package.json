{
  "name": "shortstudio",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "render": "tsx apps/render/render.ts",
    "audio": "tsx apps/render/audio.ts",
    "qa": "tsx apps/render/qa.ts",
    "export": "tsx apps/render/export.ts",
    "produce": "tsx apps/render/produce.ts",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "desktop:build": "vite build -c apps/desktop/vite.config.ts && node apps/desktop/build.mjs",
    "desktop:start": "electron apps/desktop",
    "desktop:dist": "npm run desktop:build && cd apps/desktop && electron-builder --config electron-builder.yml"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.12",
    "ffmpeg-static": "^5.3.0",
    "playwright": "1.63.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
